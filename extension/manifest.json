{
  "manifest_version": 3,
  "name": "Connect2 LinkedIn Importer",
  "version": "1.0.0",
  "description": "Importez des profils LinkedIn de freelances directement dans Connect2",
  "permissions": ["activeTab", "storage"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/in/*"],
      "js": ["content.js"],
      "css": ["content.css"]
    }
  ],
  "icons": {
    "48": "icon.png",
    "128": "icon.png"
  }
}
