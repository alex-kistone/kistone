{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/studio",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/recruter/fractional-rpo",
      "destination": "/recruter/tech-recruiter",
      "permanent": true
    },
    {
      "source": "/recruter/fractional-cto",
      "destination": "/recruter/ai-leader",
      "permanent": true
    },
    {
      "source": "/recruter/fractional-cdo",
      "destination": "/recruter/ai-leader",
      "permanent": true
    },
    {
      "source": "/recruter/fractional-cpo",
      "destination": "/recruter/ai-product-manager",
      "permanent": true
    },
    {
      "source": "/recruter/fractional-drh",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/recruter/fractional-cfo",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/recruter/fractional-coo",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/recruter/fractional-cro",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/modeles/interim-transition",
      "destination": "/modeles/mission-freelance",
      "permanent": true
    },
    {
      "source": "/ressources/comparatif-acteurs-fractional",
      "destination": "/ressources/comparatif-plateformes-freelance-ia",
      "permanent": true
    },
    {
      "source": "/ressources/freelancing-en-france-2016-2026",
      "destination": "/ressources",
      "permanent": true
    },
    {
      "source": "/ressources/fractional-leaders-10-ans-freelancing-france",
      "destination": "/ressources",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/(register|profile|dashboard|login|forgot-password|reset-password|open-needs|client)",
      "destination": "/app.html"
    },
    {
      "source": "/client/:path*",
      "destination": "/app.html"
    },
    {
      "source": "/ressources/:slug",
      "destination": "/app.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://client.crisp.chat https://settings.crisp.chat; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://client.crisp.chat; font-src 'self' data: https://fonts.gstatic.com https://client.crisp.chat; img-src 'self' data: blob: https:; connect-src 'self' https://cqtrqkslzztceiuhhilo.supabase.co wss://cqtrqkslzztceiuhhilo.supabase.co https://recherche-entreprises.api.gouv.fr https://client.crisp.chat https://storage.crisp.chat wss://client.relay.crisp.chat wss://stream.relay.crisp.chat; frame-src 'self' blob: https://game.crisp.chat; media-src 'self' https://client.crisp.chat; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
